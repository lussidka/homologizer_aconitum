from pathlib import Path
import csv

# Snakemake pipeline pro stepping-stone analýzu
WORKDIR = Path(workflow.current_basedir).resolve()


def load_target_samples():
    target_csv = WORKDIR / "scripts" / "data" / "target_samples.csv"
    rows = []
    with target_csv.open("r", encoding="utf-8-sig", newline="") as fh:
        reader = csv.DictReader(fh, delimiter=";")
        for row in reader:
            sample = (row.get("vzorek") or "").strip()
            if not sample:
                continue
            rpb2 = int((row.get("RPB2") or "0").strip())
            eif3e = int((row.get("Eif3E") or "0").strip())
            max_copies = int((row.get("polyploidie") or "0").strip())
            max_real = max(rpb2, eif3e)

            # Stejné filtrování jako v bash skriptu:
            if max_real >= max_copies:
                continue

            ploidies = list(range(max_real, max_copies + 1))
            rows.append((sample, ploidies))
    return rows


