from pathlib import Path

WORKDIR = Path(workflow.current_basedir).resolve()
REPLICATES = [1, 2, 3, 4, 5]

# Automaticky najde všechny .Rev skripty ve složce scripts/
REV_SCRIPTS, = glob_wildcards("scripts/{script}.Rev")

# ------------------------------------------------------------------------------
# 1. CÍL PIPELINE
# ------------------------------------------------------------------------------
rule all:
    input:
        "scripts/txt_files/results_ss_values.csv"

# ------------------------------------------------------------------------------
# 2. SAMOTNÝ VÝPOČET (RevBayes - paralelně pro každý nalezený skript a replikát)
# ------------------------------------------------------------------------------
rule run_ss_replicate:
    input:
        rev="scripts/{script}.Rev"
    output:
        "scripts/txt_files/{script}_{replicate}.txt"
    params:
        workdir=str(WORKDIR)
    shell:
        """
        # 1. Složka pro textové logy
        mkdir -p scripts/txt_files
        
        # 2. Unikátní pracovní složka pro tento běh
        RUN_DIR="scripts/run_{wildcards.script}_rep{wildcards.replicate}"
        mkdir -p $RUN_DIR
        
        # 3. Zkopírování skriptu a link na data
        cp {input.rev} $RUN_DIR/
        ln -sf {params.workdir}/scripts/nexus_files_samples $RUN_DIR/nexus_files_samples
        
        # 4. Spuštění výpočtu
        cd $RUN_DIR
        rb {wildcards.script}.Rev > {params.workdir}/scripts/txt_files/{wildcards.script}_{wildcards.replicate}.txt || true
        """

# ------------------------------------------------------------------------------
# 3. EXTRAKCE DAT (Sběr hodnot Marginal Likelihoods ze všech logů)
# ------------------------------------------------------------------------------
rule extract_raw_likelihoods:
    input:
        reps=expand(
            "scripts/txt_files/{script}_{replicate}.txt",
            script=REV_SCRIPTS,
            replicate=REPLICATES
        )
    output:
        "scripts/txt_files/results_ss.csv"
    params:
        workdir=str(WORKDIR)
    shell:
        "cd {params.workdir} && bash create_tab.sh"

# ------------------------------------------------------------------------------
# 4. FINÁLNÍ STATISTIKA (Výpočet průměrů a Bayesových faktorů)
# ------------------------------------------------------------------------------
rule calculate_bayes_factors:
    input:
        "scripts/txt_files/results_ss.csv"
    output:
        "scripts/txt_files/results_ss_values.csv"
    params:
        workdir=str(WORKDIR)
    shell:
        "cd {params.workdir} && bash add_values.sh"