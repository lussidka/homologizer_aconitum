#
# Specifies a homologizer model that jointly infer the phase and phylogeny.
# Auto-generated script for sample: n_PPSK4_177 (Tested tips:1)
#

bayes_factors = FALSE
output_file = "output/stepping_stone_n_PPSK4_177_1"

# input sequence alignments
alignments = ["data/n_PPSK4_177_RPB2.nex",
              "data/n_PPSK4_177_EIF3E.nex"]
num_loci = alignments.size()

for (i in 1:num_loci) {
    data[i] = readDiscreteCharacterData(alignments[i])
}

# --- MISSING TAXA FOR CORE SAMPLES ---
data[1].addMissingTaxa("n_VJJS2_011_BLANK_1")
data[1].addMissingTaxa("n_VJJS2_011_BLANK_2")
data[1].addMissingTaxa("lyc_HHA1_072_BLANK")
data[1].addMissingTaxa("n_BHA6_068_BLANK_1")
data[1].addMissingTaxa("n_BHA6_068_BLANK_2")
data[1].addMissingTaxa("n_BHA6_068_BLANK_3")
data[1].addMissingTaxa("n_DSO2_114_BLANK_1")
data[1].addMissingTaxa("n_DSO2_114_BLANK_2")
data[1].addMissingTaxa("n_DSO2_114_BLANK_3")
data[1].addMissingTaxa("var_BOB2_057_BLANK")
data[1].addMissingTaxa("deg_UMA2_112_BLANK")
data[2].addMissingTaxa("n_VJJS2_011_BLANK")
data[2].addMissingTaxa("lyc_HHA1_072_BLANK")
data[2].addMissingTaxa("n_BHA6_068_BLANK_1")
data[2].addMissingTaxa("n_BHA6_068_BLANK_2")
data[2].addMissingTaxa("n_BHA6_068_BLANK_3")
data[2].addMissingTaxa("n_DSO2_114_BLANK_1")
data[2].addMissingTaxa("n_DSO2_114_BLANK_2")
data[2].addMissingTaxa("n_DSO2_114_BLANK_3")
data[2].addMissingTaxa("var_BOB2_057_BLANK")

# --- DYNAMIC MISSING TAXA (BLANKS) FOR TARGET SAMPLE ---
data[1].addMissingTaxa("n_PPSK4_177_BLANK_1")
data[1].addMissingTaxa("n_PPSK4_177_BLANK_2")
data[1].addMissingTaxa("n_PPSK4_177_BLANK_3")
data[2].addMissingTaxa("n_PPSK4_177_BLANK_1")
data[2].addMissingTaxa("n_PPSK4_177_BLANK_2")
data[2].addMissingTaxa("n_PPSK4_177_BLANK_3")

# --- INITIAL PHASE SETUP ---
for (i in 1:num_loci) {
    # Core Samples Block
    # n_VJJS2_011
    data[i].setHomeologPhase("n_VJJS2_011_copy1", "n_VJJS2_011_A")
    data[i].setHomeologPhase("n_VJJS2_011_copy2", "n_VJJS2_011_B")
    data[i].setHomeologPhase("n_VJJS2_011_copy3", "n_VJJS2_011_C")
    data[i].setHomeologPhase("n_VJJS2_011_BLANK", "n_VJJS2_011_D")
    # lyc_HHA1_072
    data[i].setHomeologPhase("lyc_HHA1_072_copy1", "lyc_HHA1_072_A")
    data[i].setHomeologPhase("lyc_HHA1_072_BLANK", "lyc_HHA1_072_B")
    # n_BHA6_068
    data[i].setHomeologPhase("n_BHA6_068_copy1", "n_BHA6_068_A")
    data[i].setHomeologPhase("n_BHA6_068_BLANK_1", "n_BHA6_068_B")
    data[i].setHomeologPhase("n_BHA6_068_BLANK_2", "n_BHA6_068_C")
    data[i].setHomeologPhase("n_BHA6_068_BLANK_3", "n_BHA6_068_D")
    # n_DSO2_114
    data[i].setHomeologPhase("n_DSO2_114_copy1", "n_DSO2_114_A")
    data[i].setHomeologPhase("n_DSO2_114_BLANK_1", "n_DSO2_114_B")
    data[i].setHomeologPhase("n_DSO2_114_BLANK_2", "n_DSO2_114_C")
    data[i].setHomeologPhase("n_DSO2_114_BLANK_3", "n_DSO2_114_D")
    # var_BOB2_057
    data[i].setHomeologPhase("var_BOB2_057_copy1", "var_BOB2_057_A")
    data[i].setHomeologPhase("var_BOB2_057_BLANK", "var_BOB2_057_B")
    # deg_UMA2_112
    data[i].setHomeologPhase("deg_UMA2_112_copy1", "deg_UMA2_112_A")
    data[i].setHomeologPhase("deg_UMA2_112_copy2", "deg_UMA2_112_B")
    # Dynamic Target Sample Block
    data[i].setHomeologPhase("n_PPSK4_177_copy1", "n_PPSK4_177_A")
    data[i].setHomeologPhase("n_PPSK4_177_BLANK_1", "n_PPSK4_177_B")
    data[i].setHomeologPhase("n_PPSK4_177_BLANK_2", "n_PPSK4_177_C")
    data[i].setHomeologPhase("n_PPSK4_177_BLANK_3", "n_PPSK4_177_D")
}

# add missing taxa globally
for (i in 1:num_loci) {
    for (j in 1:num_loci) {
        data[i].addMissingTaxa(data[j].taxa())
    }
}

num_tips = data[1].ntaxa()
n_branches = 2 * num_tips - 3

mvi = 0
for (i in 1:n_branches) {
    branch_lengths[i] ~ dnExponential(100)
    moves[++mvi] = mvScale(branch_lengths[i], weight=1.0)
}

topology ~ dnUniformTopology(data[1].taxa())
moves[++mvi] = mvNNI(topology, weight=40.0)
moves[++mvi] = mvSPR(topology, weight=40.0)

tree := treeAssembly(topology, branch_lengths)

# --- SUBSTITUTION MODELS ---
# RPB2 (GTR + G)
for (i in 1:1) {
    er_prior <- v(1,1,1,1,1,1)
    er[i] ~ dnDirichlet(er_prior)
    er[i].setValue(simplex(v(1,1,1,1,1,1)))
    moves[++mvi] = mvSimplexElementScale(er[i], weight=5)

    pi_prior <- v(1,1,1,1)
    pi[i] ~ dnDirichlet(pi_prior)
    pi[i].setValue(simplex(v(1,1,1,1)))
    moves[++mvi] = mvSimplexElementScale(pi[i], weight=5)
    Q[i] := fnGTR(er[i], pi[i])

    alpha ~ dnUniform( 0.0, 10 )
    sr := fnDiscretizeGamma( alpha, alpha, 4 )
    moves.append( mvScale(alpha, weight=2.0) )

    if (i == 1) {
        rate_multiplier[i] <- 1.0
    } else {
        rate_multiplier[i] ~ dnExponential(1)
        moves[++mvi] = mvScale(rate_multiplier[i], weight=5)
    }
}
for (i in 1:1) {
    ctmc[i] ~ dnPhyloCTMC(tree=tree, Q=Q[i], siteRates=sr, branchRates=rate_multiplier[i], type="DNA")
}

# EIF3E (HKY + G)
for (i in 2:2) {
    kappa ~ dnLognormal(0.0, 1.0)
    moves.append( mvScale(kappa) )

    pi_prior <- v(1,1,1,1)
    pi[i] ~ dnDirichlet(pi_prior)
    pi[i].setValue(simplex(v(1,1,1,1)))
    moves[++mvi] = mvSimplexElementScale(pi[i], weight=5)
    Q[i] := fnHKY(kappa, pi[i])

    alpha ~ dnUniform( 0.0, 10 )
    sr := fnDiscretizeGamma( alpha, alpha, 4 )
    moves.append( mvScale(alpha, weight=2.0) )

    if (i == 1) {
        rate_multiplier[i] <- 1.0
    } else {
        rate_multiplier[i] ~ dnExponential(1)
        moves[++mvi] = mvScale(rate_multiplier[i], weight=5)
    }
}
for (i in 2:2) {
    ctmc[i] ~ dnPhyloCTMC(tree=tree, Q=Q[i], siteRates=sr, branchRates=rate_multiplier[i], type="DNA")
}

# --- PHASING PROPOSALS (MOVES) ---
for (i in 1:num_loci) {
    # Core Samples Moves
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_VJJS2_011_A", "n_VJJS2_011_B", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_VJJS2_011_A", "n_VJJS2_011_C", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_VJJS2_011_A", "n_VJJS2_011_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_VJJS2_011_B", "n_VJJS2_011_C", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_VJJS2_011_B", "n_VJJS2_011_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_VJJS2_011_C", "n_VJJS2_011_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "lyc_HHA1_072_A", "lyc_HHA1_072_B", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_BHA6_068_A", "n_BHA6_068_B", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_BHA6_068_A", "n_BHA6_068_C", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_BHA6_068_A", "n_BHA6_068_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_BHA6_068_B", "n_BHA6_068_C", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_BHA6_068_B", "n_BHA6_068_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_BHA6_068_C", "n_BHA6_068_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_DSO2_114_A", "n_DSO2_114_B", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_DSO2_114_A", "n_DSO2_114_C", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_DSO2_114_A", "n_DSO2_114_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_DSO2_114_B", "n_DSO2_114_C", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_DSO2_114_B", "n_DSO2_114_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "n_DSO2_114_C", "n_DSO2_114_D", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "var_BOB2_057_A", "var_BOB2_057_B", weight=2)
    moves[++mvi] = mvHomeologPhase(ctmc[i], "deg_UMA2_112_A", "deg_UMA2_112_B", weight=2)
    # Dynamic Moves for Target Sample based on TESTED_TIPS (1)

}

for (i in 1:num_loci) {
    ctmc[i].clamp(data[i])
}
mymodel = model(Q)

# --- MONITORS & RUN ---
mni = 0
monitors[++mni] = mnModel(filename=output_file + ".log", printgen=1)
monitors[++mni] = mnFile(filename=output_file + ".trees", printgen=1, tree)
monitors[++mni] = mnScreen(printgen=1)
for (i in 1:num_loci){
    monitors[++mni] = mnHomeologPhase(filename=output_file + "_locus_" + i + "_phase.log", printgen=1, ctmc[i])
}

if (bayes_factors) {
    pow_p = powerPosterior(mymodel, moves, monitors, output_file + ".out", cats=50, sampleFreq=1) 
    pow_p.burnin(generations=200, tuningInterval=50)
    pow_p.run(generations=1000)  
    ss = steppingStoneSampler(file=output_file + ".out", powerColumnName="power", likelihoodColumnName="likelihood")
    print(ss.marginal())
} else {
    pow_p = powerPosterior(mymodel, moves, monitors, output_file + ".out", cats=50, sampleFreq=1) 
    pow_p.burnin(generations=200, tuningInterval=50)
    pow_p.run(generations=1000)
    ss = steppingStoneSampler(file=output_file + ".out", powerColumnName="power", likelihoodColumnName="likelihood")
    print(ss.marginal())
}
q()
